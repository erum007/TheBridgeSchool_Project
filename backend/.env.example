# ─── Aiven MySQL (shared team database) ───
# Get these values from the team lead or the Aiven console
DB_HOST=mysql-741a078-zainjawad50-a30a.i.aivencloud.com
DB_PORT=15888
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
DB_SSL_CA=ca.pem

# ─── App Secrets ───
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Time zone used only when an older client submits a reminder time without an
# explicit UTC offset. New clients submit UTC timestamps.
APP_TIMEZONE=Asia/Karachi

# ─── Gmail Integration ───
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_SENDER=
GMAIL_APP_PASSWORD=

# Brevo HTTPS transactional email for deployed environments (works on Railway Free/Hobby).
# Add and verify BREVO_SENDER_EMAIL in Brevo before using it.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=The Bridge School
BREVO_REPLY_TO=

# ─── AI (Gemini) ───
GEMINI_API_KEY=

# ─── Web Push (VAPID) ───
# Generate once for the deployed application. Keep the private key secret.
# Example: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key_urlsafe_base64); print(v.private_pem())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bridge.school

# â”€â”€â”€ Deployment URLs â”€â”€â”€
# Comma-separated frontend origins when the frontend is hosted separately.
# CORS_ORIGINS=https://portal.example.com
# Canonical public URL used for uploaded images embedded in outgoing emails.
# Leave unset when the reverse proxy passes the public host through to the API.
# PUBLIC_BASE_URL=https://api.example.com
