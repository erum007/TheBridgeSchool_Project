{
  "name": "com.thebridgeschool.portal",
  "displayName": "The Bridge School",
  "version": "1.0.0",
  "description": "The Bridge School mobile portal.",
  "main": "index.js",
  "scripts": {
    "build:android": "cordova build android",
    "prepare:android": "cordova prepare android"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "cordova-android": "^15.1.0",
    "cordova-plugin-file": "^8.1.3",
    "cordova-plugin-file-opener2": "^4.0.0",
    "cordova-plugin-firebasex-messaging": "^2.0.1",
    "cordova-plugin-inappbrowser": "^7.0.0",
    "cordova-plugin-secure-storage-echo": "^5.1.1"
  },
  "cordova": {
    "platforms": ["android"],
    "plugins": {
      "cordova-plugin-file": {},
      "cordova-plugin-file-opener2": {},
      "cordova-plugin-firebasex-messaging": {
        "FIREBASE_FCM_AUTOINIT_ENABLED": "true",
        "FIREBASE_MESSAGING_IMMEDIATE_PAYLOAD_DELIVERY": "false",
        "IOS_FCM_ENABLED": "true",
        "IOS_ENABLE_CRITICAL_ALERTS_ENABLED": "false",
        "ANDROID_ICON_ACCENT": "#FFFFFF",
        "ANDROID_FIREBASE_MESSAGING_VERSION": "25.0.2"
      },
      "cordova-plugin-inappbrowser": {},
      "cordova-plugin-secure-storage-echo": {}
    }
  }
}
